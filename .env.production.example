# Copy to .env (same directory as docker-compose.yml) and fill values.
# Every var listed here is referenced by docker-compose.yml.
#
# Mark any secret with `secret:` in your comments so ops know to source
# it from a vault rather than commit it. Keys NEVER go in git.

# ---- Postgres (stays inside the docker network) -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=content_assist

# ---- Server auth ---------------------------------------------------------
# secret: generate with `openssl rand -base64 64`. Required.
JWT_SECRET=

# ---- AI providers --------------------------------------------------------
# secret: from console.anthropic / platform.openai / ai.google.dev / replicate.com
GEMINI_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# ---- Object storage (S3-compatible) --------------------------------------
# Used for saved images/videos + user-uploaded media. Can be AWS S3 or DO
# Spaces (set S3_ENDPOINT to the DO spaces URL). Required in prod —
# without it, /videos/:id.mp4 URLs fall back to the server's tmp dir and
# rotate away within an hour.
#
# Names follow the AWS SDK convention (the server config imports these
# directly into the S3 client).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Only set for non-AWS providers (DO Spaces, R2, MinIO).
S3_ENDPOINT=

# ---- Public URL ----------------------------------------------------------
# Outward-facing origin the browser hits. For a bare droplet without a
# domain, use http://DROPLET_IP. With a domain + SSL, https://yourdomain.
PUBLIC_ORIGIN=http://localhost

# ---- Admin build-time ----------------------------------------------------
# Passed as a Docker build arg to inline into Next.js at build time.
# Default /api pairs with nginx routing /api/* to the server container.
NEXT_PUBLIC_API_URL=/api

# ---- Nginx port ----------------------------------------------------------
# Public HTTP port. Set to 80 on the droplet; 8080 for local testing.
NGINX_HTTP_PORT=80
